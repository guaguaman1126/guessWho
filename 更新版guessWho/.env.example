NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4000
# Server
PORT=4000
WEB_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=（第三階段設定，勿提交金鑰）
