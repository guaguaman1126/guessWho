rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function room(roomId) {
      return firestore.get(/databases/(default)/documents/rooms/$(roomId));
    }

    function isPlayer(roomId) {
      return request.auth != null && request.auth.uid in room(roomId).data.playerUids;
    }

    function isLobbyHost(roomId) {
      return request.auth != null
        && room(roomId).data.hostUid == request.auth.uid
        && room(roomId).data.status == 'lobby';
    }

    match /rooms/{roomId}/cards/{cardId}/{fileName} {
      allow read: if isPlayer(roomId);
      allow create, update: if isLobbyHost(roomId)
        && firestore.exists(/databases/(default)/documents/rooms/$(roomId)/cards/$(cardId))
        && fileName.matches('^[A-Za-z0-9_-]+\\.jpg$')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if isLobbyHost(roomId);
    }
  }
}
